# =====================================================================
# Frontend environment variables (copy to frontend/.env.local if needed)
# Everything prefixed with VITE_ is embedded in the PUBLIC browser bundle:
# never put AWS keys, JWT secrets or any other secret here.
# =====================================================================

# Public URL of the backend API including the /api suffix.
# Local development: leave unset; Vite proxies /api to http://localhost:5000.
# Vercel (frontend project): https://<your-backend-project>.vercel.app/api
# VITE_API_URL=
