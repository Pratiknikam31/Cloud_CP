# =====================================================================
# Backend environment variables  (copy to backend/.env for local dev)
#   cp .env.example .env
# backend/.env is git-ignored. NEVER commit real secrets.
# On Vercel, set these in Project Settings -> Environment Variables of the
# BACKEND project instead (no .env file is used there).
# See SETUP.md section D for where each value comes from.
# =====================================================================

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS (no trailing slash).
# Local: http://localhost:5173   Production: https://<your-frontend>.vercel.app
CLIENT_URL=http://localhost:5173

# ---- Authentication (SECRET) ----
# Required. Long random string, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Amazon DynamoDB ----
# Required. The AWS region where you created the table (must match exactly).
AWS_REGION=us-east-1
# Name of the single DynamoDB table (default HospitalData).
DYNAMODB_TABLE_NAME=HospitalData

# ---- AWS credentials (choose ONE; leave the others unset) ----
# Local development, recommended: an IAM Identity Center (SSO) or named profile.
#   aws configure sso   then   aws sso login --profile hospital-dev
# AWS_PROFILE=hospital-dev
#
# Local fallback: access keys of a restricted IAM user (SECRET). Not root keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Vercel production, recommended: IAM role assumed through Vercel OIDC.
# AWS_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# ---- Optional: DynamoDB Local (testing only) ----
# When set, the SDK talks to this endpoint with dummy credentials instead of AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000
