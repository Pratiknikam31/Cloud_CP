# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# For local development: mongodb://127.0.0.1:27017/smarthospital
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/smarthospital

# JWT Authentication
JWT_SECRET=change_this_to_a_strong_random_secret_key
JWT_EXPIRES_IN=7d

# Cloudinary (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
